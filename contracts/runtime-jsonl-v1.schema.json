{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wenmo-yu/careerlens/blob/main/contracts/runtime-jsonl-v1.schema.json",
  "title": "CareerLens Runtime JSONL Protocol v1",
  "description": "自定义 v1 双向 RPC over stdio。每行一条严格 UTF-8 JSON，LF 分帧；stdout 仅写协议帧，stderr 仅写诊断。非 Pi、非 ACP，不声明上游兼容。",
  "$defs": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["v", "type", "id", "method", "params"],
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "type": { "const": "request" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "type": "string", "minLength": 1, "maxLength": 128 },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["v", "type", "id", "ok"],
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "type": { "const": "response" },
        "id": { "$ref": "#/$defs/id" },
        "ok": { "type": "boolean" },
        "result": { "type": "object" },
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [
        { "required": ["result"] },
        { "required": ["error"] }
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["v", "type", "run_id", "attempt", "runtime_generation", "local_seq", "kind", "payload"],
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "type": { "const": "event" },
        "run_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "runtime_generation": { "type": "integer", "minimum": 1 },
        "local_seq": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ]
}
