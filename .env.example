APP_NAME=CareerLens API
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/career
AUTO_CREATE_SCHEMA=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=career_evidence
QDRANT_API_KEY=
QDRANT_CLEANUP_COLLECTIONS=
UPLOAD_MAX_BYTES=10485760
MEDIA_UPLOAD_MAX_BYTES=209715200
MEDIA_PROVIDER=auto
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OCR_LANGUAGE=ch
RETRIEVAL_BACKEND=auto
RETRIEVAL_PROVIDER=hash
EMBEDDING_DIMENSION=384
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
QWEN_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
QWEN_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RETRIEVAL_PREFETCH_LIMIT=20
RETRIEVAL_LOCAL_ROW_LIMIT=2000
RETRIEVAL_QUERY_INSTRUCTION=Retrieve personal career evidence that supports the user's claim or job requirement.
AI_PROVIDER=demo
AI_FAILURE_POLICY=allow_fallback
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
MODEL_ROLE_BINDINGS=
RERANK_STAGES_ENABLED=false
RERANK_COARSE_TOP_K=15
RERANK_FINE_TOP_K=5
RUN_WORKER_CONCURRENCY=2
RUN_GLOBAL_CONCURRENCY=4
RUN_PENDING_PER_USER=12
RUN_LEASE_SECONDS=30
RUN_TIMEOUT_SECONDS=300
RUN_UPLOAD_MAX_BYTES=20971520
RUN_PENDING_HOURS=24
RUN_WORKER_MEMORY=2g
AI_TIMEOUT_SECONDS=60
AI_INPUT_PRICE_PER_MILLION=0
AI_OUTPUT_PRICE_PER_MILLION=0
# Agent Model Gateway (M5). demo/scripted run offline and need no key;
# openai_compatible, deepseek and local require a non-empty AI_API_KEY above.
# Never commit a real key to this file.
AGENT_MODEL_PROVIDER=demo
# Empty AGENT_MODEL_NAME falls back to AI_MODEL.
AGENT_MODEL_NAME=
AGENT_MODEL_TEMPERATURE=0.1
AGENT_MODEL_MAX_TOKENS=2048
AGENT_MODEL_RETRIES=2
AGENT_MODEL_BACKOFF_MS=250
# 0 falls back to AI_TIMEOUT_SECONDS.
AGENT_MODEL_STREAM_TIMEOUT_SECONDS=0
# Optional file broker root. Empty means workspace file tools are disabled.
AGENT_WORKSPACE_ROOT=
AGENT_FILE_ALLOW_EXTENSIONS=.txt,.md,.json,.csv
AGENT_FILE_MAX_BYTES=1048576
# Target for cleaning up PostgreSQL checkpoints left by older releases.
CHECKPOINT_BACKEND=auto
CHECKPOINT_DATABASE_URL=
LANGGRAPH_STRICT_MSGPACK=true
AUTH_MODE=disabled
AUTH_TOKEN_PEPPER=change-me-in-production
AUTH_TOKEN_KEY_VERSION=1
AUTH_TOKEN_PREVIOUS_PEPPER=
AUTH_TOKEN_PREVIOUS_UNTIL=
AUTH_TOKEN_LIFETIME_HOURS=24
AUTH_REGISTRATION_SECRET=
AUTH_REGISTRATION_ENABLED=true
OPS_ACCESS_TOKEN=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=careerlens-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerlens-local
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_STREAMABLE_HTTP_PATH=/mcp
MCP_AUTH_MODE=disabled
MCP_AUTH_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_SERVER_URL=http://localhost:8001/mcp
MCP_STDIO_USER_ID=demo-user
MCP_STDIO_TOKEN=

