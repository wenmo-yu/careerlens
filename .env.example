APP_NAME=CareerLens API
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/career
AUTO_CREATE_SCHEMA=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=career_evidence
UPLOAD_MAX_BYTES=10485760
MEDIA_UPLOAD_MAX_BYTES=209715200
MEDIA_PROVIDER=auto
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OCR_LANGUAGE=ch
RETRIEVAL_BACKEND=auto
RETRIEVAL_PROVIDER=hash
EMBEDDING_DIMENSION=384
QWEN_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
QWEN_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RETRIEVAL_PREFETCH_LIMIT=20
RETRIEVAL_QUERY_INSTRUCTION=Retrieve personal career evidence that supports the user's claim or job requirement.
AI_PROVIDER=demo
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=60
AI_INPUT_PRICE_PER_MILLION=0
AI_OUTPUT_PRICE_PER_MILLION=0
CHECKPOINT_BACKEND=auto
CHECKPOINT_DATABASE_URL=
LANGGRAPH_STRICT_MSGPACK=true
AUTH_MODE=disabled
AUTH_TOKEN_PEPPER=change-me-in-production
AUTH_REGISTRATION_SECRET=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=careerlens-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerlens-local
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_STREAMABLE_HTTP_PATH=/mcp
MCP_AUTH_MODE=disabled
MCP_AUTH_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_SERVER_URL=http://localhost:8001/mcp

