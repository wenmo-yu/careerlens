# Copy to .env before using docker-compose.production.yml.
# Use URL-safe random values for POSTGRES_PASSWORD because it is embedded in a connection URL.
APP_ENV=production
POSTGRES_PASSWORD=replace-with-url-safe-random-password
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
AUTH_TOKEN_KEY_VERSION=1
AUTH_TOKEN_LIFETIME_HOURS=24
AUTH_TOKEN_PREVIOUS_PEPPER=
AUTH_TOKEN_PREVIOUS_UNTIL=
# Use the provision command for owner credentials. HTTP registration requires ops when enabled.
AUTH_REGISTRATION_ENABLED=false
AUTH_REGISTRATION_SECRET=
# Independent credential for instance-wide evaluation and observability.
OPS_ACCESS_TOKEN=
METRICS_ENABLED=false
QDRANT_API_KEY=replace-with-vector-service-api-key

# Browser-visible API URL and allowed web origins.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
CORS_ORIGINS=https://career.example.com
MCP_AUTH_ISSUER_URL=https://api.example.com
MCP_RESOURCE_SERVER_URL=https://mcp.example.com/mcp

# Use deepseek/openai_compatible/local. Keep secrets only in .env, never commit it.
AI_PROVIDER=deepseek
AI_FAILURE_POLICY=strict
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-with-provider-api-key
AI_MODEL=deepseek-flash
MODEL_ROLE_BINDINGS=
RERANK_STAGES_ENABLED=false
RERANK_COARSE_TOP_K=15
RERANK_FINE_TOP_K=5
RUN_WORKER_CONCURRENCY=2
RUN_GLOBAL_CONCURRENCY=4
RUN_PENDING_PER_USER=12
RUN_LEASE_SECONDS=30
RUN_TIMEOUT_SECONDS=300
RUN_UPLOAD_MAX_BYTES=20971520
RUN_PENDING_HOURS=24
RUN_WORKER_MEMORY=2g
AI_TIMEOUT_SECONDS=60
AI_INPUT_PRICE_PER_MILLION=0
AI_OUTPUT_PRICE_PER_MILLION=0

RETRIEVAL_BACKEND=auto
RETRIEVAL_PROVIDER=hash
QDRANT_COLLECTION=career_evidence
QDRANT_CLEANUP_COLLECTIONS=
# Preserve these settings when old deployments used a separate checkpoint database.
CHECKPOINT_BACKEND=auto
CHECKPOINT_DATABASE_URL=

OTEL_ENABLED=false
OTEL_SERVICE_NAME=careerlens-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerlens-production
