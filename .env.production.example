# Copy to .env before using docker-compose.production.yml.
# Use URL-safe random values for POSTGRES_PASSWORD because it is embedded in a connection URL.
APP_ENV=production
POSTGRES_PASSWORD=replace-with-url-safe-random-password
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
AUTH_REGISTRATION_SECRET=replace-with-at-least-32-random-characters

# Browser-visible API URL and allowed web origins.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
CORS_ORIGINS=https://career.example.com

# Use deepseek/openai_compatible/local. Keep secrets only in .env, never commit it.
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-with-provider-api-key
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=60
AI_INPUT_PRICE_PER_MILLION=0
AI_OUTPUT_PRICE_PER_MILLION=0

RETRIEVAL_BACKEND=auto
RETRIEVAL_PROVIDER=hash

OTEL_ENABLED=false
OTEL_SERVICE_NAME=careerlens-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerlens-production
